# Local mode runs the mock identity providers. No real credentials.
IDP_MODE=local
SESSION_SECRET=replace-me-for-anything-but-local-lab

# Auth0 mode. See docs/auth0-setup.md. Never commit real values.
# IDP_MODE=auth0
# AUTH0_DOMAIN=your-tenant.us.auth0.com
# AUTH0_CLIENT_ID=
# AUTH0_CLIENT_SECRET=
# AUTH0_AUDIENCE=https://api.fieldnote.lab
# AUTH0_ENTERPRISE_CONNECTION=
